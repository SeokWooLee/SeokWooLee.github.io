---
import { getCollection, render } from 'astro:content';
import ArchivePage from '../components/ArchivePage.astro';
import PostPage from '../components/PostPage.astro';
import { getPostSlug, PAGE_SIZE, sortPosts, type Post } from '../lib/posts';

type PostProps = {
  kind: 'post';
  post: Post;
  newerPost?: Post;
  olderPost?: Post;
};

type ArchiveProps = {
  kind: 'archive';
  posts: Post[];
  currentPage: number;
  pageCount: number;
};

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts'));
  const pageCount = Math.ceil(posts.length / PAGE_SIZE);
  const postPaths = posts.map((post, index) => ({
    params: { slug: getPostSlug(post) },
    props: {
      kind: 'post' as const,
      post,
      newerPost: posts[index - 1],
      olderPost: posts[index + 1],
    },
  }));
  const archivePaths = Array.from({ length: pageCount - 1 }, (_, index) => {
    const currentPage = index + 2;
    const offset = (currentPage - 1) * PAGE_SIZE;

    return {
      params: { slug: `page${currentPage}` },
      props: {
        kind: 'archive' as const,
        posts: posts.slice(offset, offset + PAGE_SIZE),
        currentPage,
        pageCount,
      },
    };
  });

  return [...postPaths, ...archivePaths];
}

const props = Astro.props as PostProps | ArchiveProps;
const renderedPost = props.kind === 'post' ? await render(props.post) : undefined;
---

{props.kind === 'post' && renderedPost ? (
  <PostPage
    post={props.post}
    Content={renderedPost.Content}
    headings={renderedPost.headings}
    newerPost={props.newerPost}
    olderPost={props.olderPost}
  />
) : props.kind === 'archive' ? (
  <ArchivePage
    posts={props.posts}
    currentPage={props.currentPage}
    pageCount={props.pageCount}
  />
) : null}
