---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label } = Astro.props;
---

<span class:list={['paw-mark', className]} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <i class="paw-mark__toe paw-mark__toe--one"></i>
  <i class="paw-mark__toe paw-mark__toe--two"></i>
  <i class="paw-mark__toe paw-mark__toe--three"></i>
  <i class="paw-mark__toe paw-mark__toe--four"></i>
  <i class="paw-mark__pad"></i>
</span>

<style>
  .paw-mark {
    position: relative;
    display: inline-block;
    width: 2.2em;
    height: 2em;
    flex: 0 0 auto;
    color: currentColor;
    transform: rotate(-7deg);
  }

  .paw-mark i {
    position: absolute;
    display: block;
    background: currentColor;
  }

  .paw-mark__toe {
    width: 0.48em;
    height: 0.64em;
    border-radius: 55% 55% 48% 48%;
  }

  .paw-mark__toe--one {
    top: 0.48em;
    left: 0.08em;
    transform: rotate(-25deg);
  }

  .paw-mark__toe--two {
    top: 0.02em;
    left: 0.55em;
    transform: rotate(-9deg);
  }

  .paw-mark__toe--three {
    top: 0;
    right: 0.52em;
    transform: rotate(9deg);
  }

  .paw-mark__toe--four {
    top: 0.5em;
    right: 0.06em;
    transform: rotate(25deg);
  }

  .paw-mark__pad {
    left: 0.54em;
    bottom: 0.04em;
    width: 1.16em;
    height: 0.92em;
    border-radius: 52% 52% 44% 44%;
    transform: rotate(45deg);
  }
</style>
