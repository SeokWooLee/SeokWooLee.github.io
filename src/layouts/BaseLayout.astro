---
import { SITE } from '../config';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  modifiedAt?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = SITE.defaultImage,
  canonicalPath = Astro.url.pathname,
  type = 'website',
  publishedAt,
  modifiedAt,
  tags = [],
  noindex = false,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
const structuredData = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title.replace(` | ${SITE.name}`, ''),
      description,
      image: [socialImage.href],
      datePublished: publishedAt?.toISOString(),
      dateModified: modifiedAt?.toISOString() ?? publishedAt?.toISOString(),
      inLanguage: SITE.locale,
      mainEntityOfPage: canonical.href,
      author: {
        '@type': 'Person',
        name: SITE.author.name,
        alternateName: SITE.author.alternateName,
        url: SITE.author.github,
      },
      publisher: {
        '@type': 'Person',
        name: SITE.author.name,
      },
      keywords: tags.join(', '),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.name,
      alternateName: SITE.tagline,
      url: new URL('/', Astro.site ?? Astro.url.origin).href,
      description: SITE.description,
      inLanguage: SITE.locale,
      author: {
        '@type': 'Person',
        name: SITE.author.name,
        alternateName: SITE.author.alternateName,
        url: SITE.author.github,
      },
    };
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={`${SITE.author.name} (${SITE.author.alternateName})`} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="google-site-verification" content="tU-7oFJWhiIi8339hX2S7w5kSqAe5QI9FnFWP3uZKyg" />
    <meta name="naver-site-verification" content="adc0c8f8b835845bab36ee5d087fb89c5ad23c1b" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={new URL('/rss.xml', Astro.site ?? Astro.url.origin)} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1729" />
    <meta property="og:image:height" content="910" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" is:inline set:html={structuredDataJson}></script>
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseId}`}
      crossorigin="anonymous"
    ></script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analyticsId}`}></script>
    <script is:inline define:vars={{ analyticsId: SITE.analyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', analyticsId, { anonymize_ip: true });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
