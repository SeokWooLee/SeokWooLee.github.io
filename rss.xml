---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ '/' | absolute_url }}</link>
    <description>{{ site.description | xml_escape }}</description>
    <language>{{ site.locale | default: 'ko-KR' }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll</generator>
    <atom:link href="{{ '/rss.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    {%- for post in site.posts limit: 50 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <dc:creator>{{ site.author.name | xml_escape }}</dc:creator>
      {%- for category in post.categories %}
      <category>{{ category | xml_escape }}</category>
      {%- endfor %}
      {%- comment %} post.excerpt는 접근할 때마다 글을 다시 렌더링해 빌드 시간이 폭발한다. 렌더링 없이 읽히는 front matter의 description을 쓴다. {%- endcomment %}
      <description>{{ post.description | default: post.title | xml_escape }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
